# ---------------------------------------------------------------------------
# SEARCHHH - single .gitignore for the monorepo (Android + Python + tooling)
# ---------------------------------------------------------------------------

# --- Secrets / local config (never commit) --------------------------------
.env
.env.*
!.env.example
*.jks
*.keystore
!debug.keystore
local.properties
secrets.properties
google-services.json
!google-services.json.example
service-account*.json
firebase-adminsdk*.json
*.pem

# --- Python ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
site/
*.log
.python-version

# --- Android / Gradle -----------------------------------------------------
.gradle/
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.cxx/
android/local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
output-metadata.json
lint-results*.xml
lint-results*.html
android/app/release/

# --- IDE / OS -------------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# --- Generated artifacts --------------------------------------------------
artifacts/
export/
licenses-report/
stack/.cache/
