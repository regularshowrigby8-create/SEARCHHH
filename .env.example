# ---------------------------------------------------------------------------
# SEARCHHH API - copy to .env and fill in what you have.
# Everything is OPTIONAL: with no .env at all the API runs in offline/demo mode
# (in-memory catalog, heuristic insights, no Sentry, rate-limit in memory).
# ---------------------------------------------------------------------------

# --- identity ---------------------------------------------------------------
ENV=local                      # local | ci | staging | production
DEBUG=true
APP_VERSION=0.1.0
GIT_SHA=dev
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=*

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
DEV_AUTH_ENABLED=true
API_KEY=                       # optional: protects /api/v1/admin/*

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_SEARCH=60/minute

# --- Supabase (primary data plane) -----------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_ENTRIES=entries
SUPABASE_TABLE_FEEDBACK=feedback

# --- optional infrastructure ------------------------------------------------
DATABASE_URL=                  # postgresql+asyncpg://user:pass@host:5432/db
REDIS_URL=                     # redis://localhost:6379/0

# --- observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.25
SENTRY_ENVIRONMENT=

# --- AI providers (both optional; heuristic fallback always works) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- product knobs ----------------------------------------------------------
SEARCH_MAX_LIMIT=50
SEARCH_DEFAULT_LIMIT=20
FUZZY_THRESHOLD=62
